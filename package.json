{
  "name": "quota-board",
  "version": "0.1.0",
  "description": "See every AI subscription's limits, resets and live usage in one place: Claude, ChatGPT/Codex, Cursor, Google Antigravity, OpenCode and more.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dinosaurav/quota-board.git"
  },
  "bin": {
    "quota-board": "bin/quota-board.mjs"
  },
  "files": [
    "bin",
    "src",
    "collectors",
    "plans",
    "schema",
    "web",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --no-warnings bin/quota-board.mjs",
    "serve": "node --no-warnings bin/quota-board.mjs serve",
    "check": "node tools/check.mjs",
    "docs": "node tools/plans-doc.mjs",
    "build": "node tools/plans-doc.mjs && node tools/bundle.mjs",
    "test": "node --no-warnings --test test/collectors.test.mjs test/core.test.mjs"
  },
  "keywords": [
    "ai",
    "usage",
    "quota",
    "rate-limit",
    "claude",
    "codex",
    "cursor",
    "gemini",
    "antigravity",
    "cli"
  ]
}
